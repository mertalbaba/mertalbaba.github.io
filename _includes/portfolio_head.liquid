<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% unless page.url == '/' %}{{ page.title }} · {% endunless %}Mert Albaba</title>
<meta name="description" content="{{ page.description | default: site.description | strip | escape }}">
<meta name="theme-color" content="#2b2b2b">
<link rel="canonical" href="{{ page.url | absolute_url }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{% unless page.url == '/' %}{{ page.title }} · {% endunless %}Mert Albaba">
<meta property="og:description" content="{{ page.description | default: site.description | strip | escape }}">
<meta property="og:url" content="{{ page.url | absolute_url }}">
<meta property="og:image" content="{{ '/assets/img/prof_pic_mert.jpg' | absolute_url }}">
<link rel="icon" href="{{ '/assets/img/monogram.svg' | relative_url }}" type="image/svg+xml">
<link rel="preload" href="{{ '/assets/fonts/AspektaVF.woff2' | relative_url }}" as="font" type="font/woff2" crossorigin>
{% if page.collection == 'projects' %}<link rel="stylesheet" href="{{ '/assets/css/bootstrap.min.css' | relative_url }}">{% endif %}
<link rel="stylesheet" href="{{ '/assets/css/portfolio.css' | relative_url }}">
<script defer src="{{ '/assets/js/portfolio.js' | relative_url }}"></script>
{% if page.collection == 'projects' %}
<script defer src="{{ '/assets/js/mathjax-setup.js' | relative_url }}"></script>
<script defer src="{{ site.third_party_libraries.mathjax.url.js }}" crossorigin="anonymous"></script>
{% endif %}
{% if jekyll.environment == 'production' and site.enable_google_analytics %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.google_analytics }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', {{ site.google_analytics | jsonify }});
</script>
{% endif %}
