---
---
{% assign title_path = nil %}
{% if entry.website %}
  {% if entry.website contains '://' %}{% assign title_path = entry.website %}{% else %}{% assign title_path = entry.website | relative_url %}{% endif %}
{% elsif entry.html %}
  {% if entry.html contains '://' %}{% assign title_path = entry.html %}{% else %}{% assign title_path = entry.html | prepend: '/assets/html/' | relative_url %}{% endif %}
{% elsif entry.arxiv %}
  {% assign title_path = entry.arxiv | prepend: 'https://arxiv.org/abs/' %}
{% elsif entry.doi %}
  {% assign title_path = entry.doi | prepend: 'https://doi.org/' %}
{% elsif entry.url %}
  {% assign title_path = entry.url %}
{% elsif entry.pdf %}
  {% if entry.pdf contains '://' %}{% assign title_path = entry.pdf %}{% else %}{% assign title_path = entry.pdf | prepend: '/assets/pdf/' | relative_url %}{% endif %}
{% endif %}
<article class="publication-entry" id="{{ entry.key }}" data-publication>
  {% assign preview_path = nil %}
  {% if entry.preview %}
    {% assign preview_first_character = entry.preview | slice: 0 %}
    {% if entry.preview contains '://' %}
      {% assign preview_path = entry.preview %}
    {% elsif preview_first_character == '/' %}
      {% assign preview_path = entry.preview | relative_url %}
    {% else %}
      {% assign preview_path = entry.preview | prepend: '/assets/img/publication_preview/' | relative_url %}
    {% endif %}
  {% endif %}
  {% if preview_path %}
    <img class="publication-thumb" src="{{ preview_path }}" alt="Preview of {{ entry.title | strip_html | escape }}" loading="lazy" decoding="async">
  {% else %}
    <div class="publication-thumb publication-placeholder" aria-hidden="true">{{ entry.year }}</div>
  {% endif %}
  <div class="publication-copy">
    <h3 class="publication-title">{% if title_path %}<a href="{{ title_path }}">{{ entry.title }}</a>{% else %}{{ entry.title }}{% endif %}</h3>
    <p class="publication-authors">
      {%- for author in entry.author_array -%}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' | strip -%}
        {%- assign author_last_html = author.last | escape | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        {%- unless forloop.first %}, {% endunless -%}
        {%- if forloop.last and forloop.length > 1 %}and {% endif -%}
        {%- if site.scholar.last_name contains author_last_name -%}
          <strong>{{ author.first | escape }} {{ author_last_html }}</strong>
        {%- else -%}
          {{ author.first | escape }} {{ author_last_html }}
        {%- endif -%}
      {%- endfor -%}
    </p>
    {% if entry.annotation %}<p class="publication-annotation">{{ entry.annotation | escape }}</p>{% endif %}
    <p class="publication-venue">
      {% if entry.key == 'albaba2025nil' %}
        CVPR 2026
      {% elsif entry.key == 'albaba2026viola' %}
        arXiv · 2026
      {% elsif entry.key == 'bagatella2025test' %}
        ICML 2026 · PMLR 306:5200–5218
      {% else %}
        {% if entry.journal %}{{ entry.journal }}{% elsif entry.booktitle %}{{ entry.booktitle }}{% elsif entry.school %}{{ entry.school }}{% endif %}{% if entry.year %} · {{ entry.year }}{% endif %}
      {% endif %}
    </p>
    {% if entry.key == 'albaba2025nil' %}<p class="talk-note">Spotlight talk · 2nd Workshop on Agents in Interaction, from Humans to Robots.</p>{% endif %}
    {% if entry.note %}<p>{{ entry.note }}</p>{% endif %}
    {% if page.home_publications %}
      {% assign home_summary = nil %}
      {% case entry.key %}
        {% when 'albaba2026viola' %}{% assign home_summary = 'A generalist humanoid policy learned mostly from human data, enabling zero-shot locomotion and manipulation.' %}
        {% when 'albaba2025nil' %}{% assign home_summary = 'Learning robot skills from generated videos, without curated expert demonstrations.' %}
        {% when 'bagatella2025test' %}{% assign home_summary = 'Adapting goal-conditioned policies at test time using relevant experience from an offline dataset.' %}
        {% when 'diomataris2025moving' %}{% assign home_summary = 'Controlling avatar motion from egocentric vision by combining a learned motion prior with reinforcement learning.' %}
        {% when 'albaba2025rile' %}{% assign home_summary = 'Learning a reward function and an imitation policy together, with an RL-based trainer guiding a student toward expert behavior.' %}
      {% endcase %}
      {% if home_summary %}<p class="publication-summary">{{ home_summary }}</p>{% endif %}
    {% endif %}
    <div class="project-links">
      {% if entry.website %}
        {% if entry.website contains '://' %}{% assign website_path = entry.website %}{% else %}{% assign website_path = entry.website | relative_url %}{% endif %}
        <a href="{{ website_path }}">Project <span aria-hidden="true">↗</span></a>
      {% endif %}
      {% if entry.arxiv %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv <span aria-hidden="true">↗</span></a>{% endif %}
      {% if entry.doi %}<a href="https://doi.org/{{ entry.doi }}">DOI <span aria-hidden="true">↗</span></a>{% endif %}
      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}{% assign paper_path = entry.pdf %}{% else %}{% assign paper_path = entry.pdf | prepend: '/assets/pdf/' | relative_url %}{% endif %}
        <a href="{{ paper_path }}">PDF <span aria-hidden="true">↗</span></a>
      {% endif %}
      {% if entry.html %}
        {% if entry.html contains '://' %}{% assign html_path = entry.html %}{% else %}{% assign html_path = entry.html | prepend: '/assets/html/' | relative_url %}{% endif %}
        <a href="{{ html_path }}">{% if entry.key == 'bagatella2025test' %}Proceedings{% elsif entry.key == 'albaba2025rile' %}Workshop paper{% else %}Read paper{% endif %} <span aria-hidden="true">↗</span></a>
      {% endif %}
      {% if entry.code %}<a href="{{ entry.code }}">Code <span aria-hidden="true">↗</span></a>{% endif %}
      {% if entry.video %}<a href="{{ entry.video }}">Video <span aria-hidden="true">↗</span></a>{% endif %}
      {% if entry.blog %}<a href="{{ entry.blog }}">Blog <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
    {% if entry.abstract %}<details class="publication-details"><summary>Abstract</summary><p>{{ entry.abstract }}</p></details>{% endif %}
    {% if entry.bibtex_show %}<details class="publication-details"><summary>BibTeX</summary><pre><code>{{ entry.bibtex | hideCustomBibtex | escape }}</code></pre></details>{% endif %}
  </div>
</article>
{% assign show_ongoing = false %}
{% if page.url == '/publications/' or page.original_preview or page.home_publications %}{% assign show_ongoing = true %}{% endif %}
{% if entry.key == 'albaba2026viola' and show_ongoing %}
<article class="publication-entry ongoing-publication" id="dr-octopus-publication" data-publication>
  <div class="publication-thumb publication-placeholder publication-placeholder-empty" aria-hidden="true"></div>
  <div class="publication-copy">
    <h3 class="publication-title">Dr. Octopus: Universal Hand Controller</h3>
    <p class="publication-venue">Ongoing work · Paper in preparation</p>
    <p>Developed during my internship at Vesoma with Martin Riedmiller.</p>
  </div>
</article>
{% endif %}
